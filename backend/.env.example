# EchoShield Environment Configuration
# Copy this file to .env and configure appropriate values

PORT=8000
HOST=127.0.0.1
DATABASE_URL=sqlite+aiosqlite:///./echoshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SECRET_KEY=change-this-to-a-secure-random-secret-key
ENVIRONMENT=development
LOG_LEVEL=INFO
